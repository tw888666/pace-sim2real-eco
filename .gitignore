# Docker history
.isaac-lab-docker-history

# PACE specific
# Experiment data, outputs, and logs were originally versioned for reproducibility.
# Files already committed stay tracked; these rules keep *new* run artifacts out of
# git so the repository stays clonable. Add one explicitly with `git add -f` if a
# specific artifact needs to be shared.
/data/pace_eco/
/logs/
/outputs/
*.pdf

# PACE-ECO 多地形实验运行产物与外部标定数据
/results/supplementary/multi_terrain_v1_4/
/results/supplementary/direction_conditioned_v2_3_mixed/
/pace_data
*.npy
